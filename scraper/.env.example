# NOTE: the scraper reads REDIS_PUBLIC_URL, NOT REDIS_URL like the backend does.
# Passing REDIS_URL here silently leaves Redis_URL empty and the process exits on the
# missing-env guard in src/index.ts.
REDIS_PUBLIC_URL=redis://redis:6379
RABBITMQ_URL=amqp://user:pass@rabbitmq:5672

# Stable per-container identity. Used for this scraper's Redis channels
# (<ID>_domain, <ID>_status) and as the log prefix. Falls back to a random uuid,
# which makes logs unattributable across restarts — set it in compose/makefile.
INSTANCE_ID=scraper-1

# development | production. Only gates optional local log file writes today.
MODE=development

# Politeness delay in ms between real page fetches on this scraper. 0 = no delay
# (previous behaviour). Raise it when crawling small or rate-limited hosts —
# effective request rate is roughly (maxPages / CRAWL_DELAY_MS) per scraper.
CRAWL_DELAY_MS=0

# How long shutdown waits for the in-flight link to finish before closing the browser.
SHUTDOWN_GRACE_MS=10000
