# Backend environment - mirrors src/config/env.ts, one entry per variable it reads.
# Copy to `.env` and fill in. Never commit a filled-in copy; the values below are placeholders.
# If a variable is missing here but read in env.ts, env.ts is right and this file is stale.

# --- Runtime -----------------------------------------------------------------------------------
# Port the API listens on.
PORT=5000
# Public origin of this API. Used when building absolute links back to the backend.
BACKEND_URL=http://localhost:5000
# Public origin of the SPA. Drives BOTH the CORS allow-list AND the verification-email link -
# a wrong value silently breaks signup (the email points somewhere the user cannot reach).
FRONTEND_URL=http://localhost:5173
# "dev" or "prod". Controls the Secure flag on the auth cookie, so it must be "prod" in production.
NODE_ENV=dev
# MODE_NODE is a DEPRECATED ALIAS of NODE_ENV, kept only so older compose files keep working.
# env.ts resolves NODE_ENV || MODE_NODE || "dev". Set NODE_ENV in new deployments.
# MODE_NODE=dev
# Number of reverse-proxy hops to trust for the client IP (Express `trust proxy`). 0 trusts
# nothing, which is correct for a directly-exposed API; set to 1 behind a single nginx.
TRUST_PROXY=0

# --- Datastores and message queue --------------------------------------------------------------
# MongoDB connection string. The database name is pinned to linkfixerDB in database/connectdb.ts.
MONGO_URI=mongodb://localhost:27017
# Redis connection string used by the API and the managers.
# NOTE: the scraper package reads REDIS_PUBLIC_URL instead - same server, different variable name.
REDIS_URL=redis://localhost:6379
# RabbitMQ connection string, shared by the API, the managers and the scrapers.
RABBITMQ_URL=amqp://user:password@localhost:5672

# --- Secrets -----------------------------------------------------------------------------------
# Signs the auth cookie JWT. Use >=32 random bytes; rotating it logs everyone out.
JWT_SECRET=change-me
# Signs email-verification JWTs only.
EMAIL_SECRET=change-me

# --- Manager / crawl tuning ---------------------------------------------------------------------
# Maximum links crawled per scan, and the size guard on Check.checkedLinks.
LINK_LIMIT=10
# Browsers leased per website by one manager process.
INSTANCES=1
# Queue this manager consumes: priority_high | priority_mid | priority_low.
QUEUE=priority_low
# Queue this manager spills overflow work into. Must be "priority_mid", never "priority_medium",
# and must name a tier that actually has a consumer below - or the work is lost.
NEXT_QUEUE=priority_mid
# How many times a scan message is retried before it is dropped.
MAX_SCAN_ATTEMPTS=2

# --- Live scan tracking (websockets) ------------------------------------------------------------
# Socket.IO mount path. Must match the frontend's VITE_WS_URL path and the nginx proxy location.
WS_PATH=/socket.io
# Minimum gap between progress frames pushed to a browser, in ms. Throttles large crawls.
SCAN_PROGRESS_THROTTLE_MS=1000

# --- Read APIs ----------------------------------------------------------------------------------
# Default page size when paginating inside Check.checkedLinks.
LINK_RESULT_PAGE_SIZE=100

# --- Reporting ----------------------------------------------------------------------------------
# Google Gemini API key used by utils/genAI/getReport.ts.
AI_API_KEY=change-me
# Gemini model id. Kept in env so a deprecated model can be swapped without a code change.
AI_MODEL=gemini-2.0-flash
# Optional operations mailbox that receives scan reports when a website has no subscribers.
# Leave empty to send reports only to subscribers - there is no hardcoded fallback address.
REPORT_EMAIL=

# --- SMTP (nodemailer) ---------------------------------------------------------------------------
# SMTP host.
SMTP_HOST=smtp.gmail.com
# SMTP port. 465 switches the transport to implicit TLS; anything else uses STARTTLS.
SMTP_PORT=587
# SMTP username. Also used as the From address on every email this service sends.
SMTP_USER=change-me
# SMTP password or app password.
SMTP_PASS=change-me

# --- Not read by config/env.ts --------------------------------------------------------------------
# Consumed by docker-compose.local.yaml and the makefile, not by application code.
# Credentials the local RabbitMQ container is created with; must match RABBITMQ_URL above.
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
# Politeness delay between page fetches, passed through to the scraper container. 0 = no delay.
CRAWL_DELAY_MS=0
