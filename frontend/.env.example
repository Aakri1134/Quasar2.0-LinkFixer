# Vite inlines these at BUILD time, not run time. Changing them requires a rebuild,
# and in Docker they must be passed as --build-arg, not as container env vars.

# Base URL for the REST API. Must end with a trailing slash.
# Single-origin deploy (recommended, see nginx/nginx.conf): /api/
# Local dev against a separate API process:                 http://localhost:5000/api/
VITE_API_URL=http://localhost:5000/api/

# Origin the socket.io client connects to. Empty/"/" means "same origin as the page",
# which is what the single-origin proxy deployment wants.
# Local dev against a separate API process: http://localhost:5000
VITE_WS_URL=http://localhost:5000
